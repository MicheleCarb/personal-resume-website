---
import type { CollectionEntry } from "astro:content";
import { ui, type Lang } from "../i18n/ui";

type Profile = CollectionEntry<"profile">["data"];

interface Props {
  lang: Lang;
  certifications: Profile["certifications"];
  languages: Profile["languages"];
}

const { lang, certifications, languages } = Astro.props;
const t = ui[lang];
---

<section class="credentials" aria-labelledby="credentials-heading">
  <h2 id="credentials-heading">{t["credentials.heading"]}</h2>
  <div class="columns">
    <div>
      <h3>{t["credentials.certifications"]}</h3>
      <ul>
        {certifications.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3>{t["credentials.languages"]}</h3>
      <ul>
        {languages.map(({ name, level }) => (
          <li>
            <span class="language">{name[lang]}</span>
            {" · "}
            {level[lang]}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .credentials {
    margin-top: var(--space-8);
  }

  h2 {
    margin-bottom: var(--space-5);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5) var(--space-6);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 700;
  }

  ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-1);
    padding: 0;
    list-style: none;
    color: var(--ink-muted);
  }

  .language {
    color: var(--ink);
  }
</style>
