---
import { getEntry } from "astro:content";
import { getStages } from "../content/stages";
import Base from "../layouts/Base.astro";
import { ui, type Lang } from "../i18n/ui";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import Pipeline from "./Pipeline.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const entry = await getEntry("profile", "michele");
if (!entry) throw new Error("Profile entry 'michele' is missing");
const profile = entry.data;
const description = `${profile.headline}. ${profile.location[lang]}.`;
const stages = await getStages();
---

<Base lang={lang} title={profile.name} description={description}>
  <LanguageSwitch lang={lang} />
  <Header lang={lang} profile={profile} />
  <main id="main" tabindex="-1">
    <section class="intro" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="visually-hidden">
        {t["intro.heading"]}
      </h2>
      <p>{profile.intro[lang]}</p>
    </section>
    <Pipeline stages={stages} lang={lang} />
  </main>
  <Footer lang={lang} repository={profile.repository} />
</Base>

<style>
  .intro {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: 1.55;
  }
</style>
