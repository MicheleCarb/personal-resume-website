---
import { dateLocale, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  repository: string;
}

const { lang, repository } = Astro.props;
const t = ui[lang];
const builtAt = new Date();
const builtLabel = new Intl.DateTimeFormat(dateLocale[lang], {
  dateStyle: "long",
}).format(builtAt);
---

<footer class="site-footer">
  <p>
    {t["footer.built"]}{" "}
    <time datetime={builtAt.toISOString()}>{builtLabel}</time>
    {" · "}
    <a href={repository}>{t["footer.source"]}</a>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
