---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const others = (Object.keys(languages) as Lang[]).filter(
  (code) => code !== lang,
);
---

<nav class="language" aria-label={ui[lang].languageNav}>
  <ul>
    {others.map((code) => (
      <li>
        <a href={getRelativeLocaleUrl(code)} hreflang={code} lang={code}>
          {languages[code]}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .language {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-3);
  }

  ul {
    display: flex;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }
</style>
