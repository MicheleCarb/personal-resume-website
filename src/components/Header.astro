---
import type { CollectionEntry } from "astro:content";
import type { Stage } from "../content/stage-rules";
import { localize, ui, type Lang } from "../i18n/ui";
import { formatPartialDate } from "../lib/dates";
import IdentityLinks from "./IdentityLinks.astro";

interface Props {
  lang: Lang;
  profile: CollectionEntry<"profile">["data"];
  /** The running stage: the masthead says where the line is now. */
  current: Stage;
}

const { lang, profile, current } = Astro.props;
const t = ui[lang];
const { handle } = profile;

// Employer, employment note, and the start of the oldest step there.
const now = [
  current.organization,
  current.employmentNote,
  `${t["now.since"]} ${formatPartialDate(current.steps[0].start, lang)}`,
]
  .filter((value) => value !== undefined)
  .map((value) => localize(value, lang))
  .join(" · ");
---

<header class="masthead" data-name-split data-handle={handle}>
  <div class="who">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="now" data-now>
      <span class="now-status">
        <span lang="en">RUNNING</span>
        <span class="visually-hidden">({t["status.running"]})</span>
      </span>
      {now}
    </p>
    <p class="location">{profile.location[lang]}</p>
    <ul class="key-facts" aria-label={t["facts.label"]} data-key-facts>
      {profile.keyFacts.map((fact) => (
        <li>{fact[lang]}</li>
      ))}
    </ul>
  </div>
  <nav aria-label={t["links.label"]}>
    <IdentityLinks
      lang={lang}
      profile={profile}
      services={["linkedin", "github", "website"]}
    />
  </nav>
</header>

<script>
  import "../scripts/name-split";
</script>

<style>
  .masthead {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 0.375rem solid var(--line);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .headline {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  /* Where the line is now, in the pipeline's own status vocabulary. */
  .now {
    margin-top: var(--space-2);
    font-weight: 600;
  }

  .now-status {
    margin-right: var(--space-2);
    color: var(--running);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .location {
    color: var(--ink-muted);
  }

  .key-facts {
    display: grid;
    gap: var(--space-1);
    max-width: var(--measure);
    margin-top: var(--space-4);
    padding-left: 1.1rem;
  }

  .key-facts li::marker {
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .masthead {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* Hero sequence (desktop): on the first scroll, decorative copies built by
     name-split.ts fly from the name into the handles while the contact block
     descends beside the intro. The sequence is timed, not tied to the scroll
     position, so it always runs to the end; the real links stay fully
     visible throughout. */
  :global(.name-split) {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  :global(.split-piece) {
    --fly: 720ms;
    --stagger: calc(var(--order) * 60ms);
    position: absolute;
    line-height: normal;
    letter-spacing: -0.02em;
    white-space: pre;
    transform-origin: 100% 0;
    opacity: 0;
  }

  .masthead:global(.is-flying) :global(.split-piece) {
    animation: split-fly var(--fly) cubic-bezier(0.2, 0.7, 0.2, 1)
      var(--stagger) both;
  }

  :global(.split-from) {
    color: var(--ink);
  }

  .masthead:global(.is-flying) :global(.split-from) {
    animation: split-out var(--fly) linear var(--stagger) both;
  }

  /* "one" stays prominent from the moment it leaves: it is the fragment
     that becomes the website, michelecarb.one. */
  :global(.split-piece[data-part="tail"] .split-from) {
    color: var(--running);
  }

  :global(.split-to) {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--running);
    letter-spacing: 0;
    opacity: 0;
  }

  .masthead:global(.is-flying) :global(.split-to) {
    animation: split-in var(--fly) linear var(--stagger) both;
  }

  /* One continuous diagonal: each copy's position (translate) runs straight
     from its part of the name to its handle's final spot beside the intro,
     while the contact block descends to meet it there. Size (scale) is keyed
     separately and reaches handle size within the first 15%, so the
     shrinking word clears the lines under the name instead of sweeping
     across them; the path itself never bends. Copies stay invisible until
     they have cleared the name (10%), so they appear at the end of "Carbone"
     rather than on top of it, and fade out over the real handle as they
     land. */
  @keyframes split-fly {
    0%,
    10% {
      opacity: 0;
    }
    0% {
      translate: 0 0;
      scale: 1;
    }
    14%,
    80% {
      opacity: 1;
    }
    15% {
      scale: var(--s);
    }
    100% {
      translate: var(--dx) var(--dy);
      scale: var(--s);
      opacity: 0;
    }
  }

  @keyframes split-out {
    38% {
      opacity: 1;
    }
    46%,
    100% {
      opacity: 0;
    }
  }

  @keyframes split-in {
    0%,
    46% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
  }

  /* The contact block descends from the top right to the column beside the
     intro (--links-dy, measured by the script) and climbs back, a little
     faster, when the page returns to the top. A transition, so a change of
     direction mid-way continues from where the block is. Transform only:
     the links stay readable and clickable throughout, and nothing reflows. */
  .masthead:global(.is-splitting) nav {
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .masthead:global(.is-landed) nav {
    transform: translateY(var(--links-dy));
    transition-duration: 720ms;
  }

  /* While the script measures, or when the page loads already scrolled. */
  .masthead:global(.is-instant) nav {
    transition: none;
  }

  /* Paper has its own layout: the links stay where the page puts them. */
  @media print {
    .masthead:global(.is-landed) nav {
      transform: none;
      transition: none;
    }

    :global(.name-split) {
      display: none;
    }
  }
</style>
