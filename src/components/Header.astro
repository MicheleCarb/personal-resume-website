---
import type { CollectionEntry } from "astro:content";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  profile: CollectionEntry<"profile">["data"];
}

const { lang, profile } = Astro.props;
const t = ui[lang];
---

<header>
  <h1>{profile.name}</h1>
  <p>{profile.headline}</p>
  <p>{profile.location[lang]}</p>
  <nav aria-label={t["links.label"]}>
    <ul>
      <li>
        <a href={profile.links.linkedin} rel="me">
          {t["links.linkedin"]}
        </a>
      </li>
      <li>
        <a href={profile.links.github} rel="me">
          {t["links.github"]}
        </a>
      </li>
      <li>
        <a href={profile.links.cv} type="application/pdf" download>
          {t["links.cv"]}
        </a>
      </li>
    </ul>
  </nav>
</header>
