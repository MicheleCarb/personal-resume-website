---
import type { CollectionEntry } from "astro:content";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  profile: CollectionEntry<"profile">["data"];
}

const { lang, profile } = Astro.props;
const t = ui[lang];
const { handle, links } = profile;

// Show each address as written ("linkedin.com/in/michelecarb"), split around
// the shared handle so the three handles line up in one column.
function identity(label: string, href: string) {
  const shown = href.replace(/^https?:\/\/(www\.)?/, "").toLowerCase();
  const at = shown.indexOf(handle);
  if (at === -1) throw new Error(`${href} does not contain "${handle}"`);
  return {
    label,
    href,
    prefix: shown.slice(0, at),
    suffix: shown.slice(at + handle.length),
  };
}

const identities = [
  identity(t["links.linkedin"], links.linkedin),
  identity(t["links.github"], links.github),
  identity(t["links.website"], links.website),
];
---

<header class="masthead">
  <div class="who">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="location">{profile.location[lang]}</p>
  </div>
  <nav aria-label={t["links.label"]}>
    <ul class="identity">
      {identities.map(({ label, href, prefix, suffix }) => (
        <li>
          <a
            href={href}
            rel="me"
            aria-label={`${label}: ${prefix}${handle}${suffix}`}
          >
            <span class="prefix">{prefix}</span>
            <span class="handle">{handle}</span>
            <span class="suffix">{suffix}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="cv">
      {links.cv ? (
        <a href={links.cv} type="application/pdf" download>
          {t["links.cv"]}
        </a>
      ) : (
        <span class="soon">{t["links.cvSoon"]}</span>
      )}
    </p>
  </nav>
</header>

<style>
  .masthead {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 0.375rem solid var(--line);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .headline {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .location {
    color: var(--ink-muted);
  }

  /* Three rows sharing one grid, so every handle sits in the same column. */
  .identity {
    display: grid;
    grid-template-columns: max-content max-content max-content;
    justify-content: start;
    row-gap: var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .identity li,
  .identity a {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .identity a {
    padding-block: var(--space-1);
    text-decoration: none;
  }

  .prefix {
    color: var(--ink-muted);
    text-align: right;
  }

  .handle {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.2em;
  }

  .suffix {
    font-weight: 800;
  }

  .identity a:hover .handle {
    color: var(--running);
    text-decoration-color: currentColor;
  }

  .cv {
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .cv a,
  .soon {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .soon {
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .masthead {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
