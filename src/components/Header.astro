---
import type { CollectionEntry } from "astro:content";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  profile: CollectionEntry<"profile">["data"];
}

const { lang, profile } = Astro.props;
const t = ui[lang];
const { handle, links } = profile;

// Show each address as written ("linkedin.com/in/michelecarb"), split around
// the shared handle so the three handles line up in one column.
function identity(label: string, href: string) {
  const shown = href.replace(/^https?:\/\/(www\.)?/, "").toLowerCase();
  const at = shown.indexOf(handle);
  if (at === -1) throw new Error(`${href} does not contain "${handle}"`);
  return {
    label,
    href,
    prefix: shown.slice(0, at),
    suffix: shown.slice(at + handle.length),
  };
}

const identities = [
  identity(t["links.linkedin"], links.linkedin),
  identity(t["links.github"], links.github),
  identity(t["links.website"], links.website),
];
---

<header class="masthead" data-name-split data-handle={handle}>
  <div class="who">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="location">{profile.location[lang]}</p>
  </div>
  <nav aria-label={t["links.label"]}>
    <ul class="identity">
      {identities.map(({ label, href, prefix, suffix }) => (
        <li>
          <a
            href={href}
            rel="me"
            aria-label={`${label}: ${prefix}${handle}${suffix}`}
          >
            <span class="prefix">{prefix}</span>
            <span class="handle">{handle}</span>
            <span class="suffix">{suffix}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="cv">
      {links.cv ? (
        <a href={links.cv} type="application/pdf" download>
          {t["links.cv"]}
        </a>
      ) : (
        <span class="soon">{t["links.cvSoon"]}</span>
      )}
    </p>
  </nav>
</header>

<script>
  import "../scripts/name-split";
</script>

<style>
  .masthead {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 0.375rem solid var(--line);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .headline {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .location {
    color: var(--ink-muted);
  }

  /* Three rows sharing one grid, so every handle sits in the same column. */
  .identity {
    display: grid;
    grid-template-columns: max-content max-content max-content;
    justify-content: start;
    row-gap: var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .identity li,
  .identity a {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .identity a {
    padding-block: var(--space-1);
    text-decoration: none;
  }

  .prefix {
    color: var(--ink-muted);
    text-align: right;
  }

  .handle {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.2em;
  }

  .suffix {
    font-weight: 800;
  }

  .identity a:hover .handle {
    color: var(--running);
    text-decoration-color: currentColor;
  }

  .cv {
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .cv a,
  .soon {
    display: inline-block;
    padding-block: var(--space-2);
  }

  .soon {
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .masthead {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  /* Experimental name split (exp/scrollytelling): decorative copies built by
     name-split.ts fly from the name into the handles over the first 160px
     of scroll, while the masthead is still on screen. Longhands only (a minifier folds a shorthand plus
     animation-timeline into a declaration browsers reject). */
  :global(.name-split) {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  :global(.split-piece) {
    position: absolute;
    line-height: normal;
    letter-spacing: -0.02em;
    white-space: pre;
    transform-origin: 0 0;
    animation-name: split-fly;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 0px 160px;
  }

  :global(.split-from),
  :global(.split-to) {
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: inherit;
  }

  :global(.split-from) {
    color: var(--ink);
    animation-name: split-out;
  }

  :global(.split-to) {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--running);
    letter-spacing: 0;
    animation-name: split-in;
  }

  @keyframes split-fly {
    0% {
      transform: none;
      opacity: 0;
    }
    4%,
    90% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx), var(--dy)) scale(var(--s));
      opacity: 0;
    }
  }

  /* Sequential, not overlapping: the name style leaves before the handle
     style arrives, so two different words are never superimposed. */
  @keyframes split-out {
    38% {
      opacity: 1;
    }
    46%,
    100% {
      opacity: 0;
    }
  }

  @keyframes split-in {
    0%,
    46% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
  }

  /* While the copies fly (only when name-split.ts is active), the landing
     zone clears: handles and ".one" step aside and prefixes dim (to 0.8,
     which keeps them at WCAG AA), then all return exactly as the copies
     land. At rest the links are fully shown. */
  .masthead:global(.is-splitting) :is(.handle, .suffix, .prefix) {
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 0px 160px;
  }

  .masthead:global(.is-splitting) :is(.handle, .suffix) {
    animation-name: landing-clear;
  }

  .masthead:global(.is-splitting) .prefix {
    animation-name: landing-dim;
  }

  @keyframes landing-clear {
    0%,
    100% {
      opacity: 1;
    }
    6%,
    92% {
      opacity: 0;
    }
  }

  @keyframes landing-dim {
    0%,
    100% {
      opacity: 1;
    }
    10%,
    85% {
      opacity: 0.8;
    }
  }
</style>
